# M7 pinned runner: the exact M6 toolchain set plus a digest-pinned Node.js
# runtime so the official @microsoft/signalr client harness runs inside the
# fixed OCI runner.
#
# The Node.js runtime is pinned to the immutable linux/amd64 image manifest of
# the official node:22-bookworm tag via `docker manifest inspect --verbose`
# (selected 2026-11-26; the digest resolves to exactly this amd64 image, no
# floating tag read at build time). Node/npm versions are recorded at build
# time and again in the M7 evidence logs; the runner image id recorded by
# scripts/linux_runner.py binds the final built image.
FROM postgres:18.7-bookworm@sha256:194e55feb2597b1465dbee81cc9fd8d204566cd2eb42c8d22fd6c931a38781b1 AS postgres_tools
FROM node:22-bookworm@sha256:81ad3f93f122008a146891525948c689cfd8e9ff9f8cb8445cc95991d7a0251c AS node_runtime
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
COPY --from=postgres_tools /usr/lib/postgresql/18/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=postgres_tools /usr/lib/postgresql/18/bin/pg_restore /usr/local/bin/pg_restore
COPY --from=postgres_tools /usr/lib/postgresql/18/bin/psql /usr/local/bin/psql
COPY --from=postgres_tools /usr/lib/x86_64-linux-gnu/libpq.so.5.* /usr/local/lib/
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ldconfig && pg_dump --version && pg_restore --version && psql --version \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version && npm --version
LABEL dev.pangolin.owner="pangolin-framework" dev.pangolin.purpose="m7-test-runner" \
      dev.pangolin.node_image="node:22-bookworm@sha256:81ad3f93f122008a146891525948c689cfd8e9ff9f8cb8445cc95991d7a0251c"
