-- An independent metadata-only function answers lifecycle inventory without
-- granting business SELECT or accepting an arbitrary SQL query.
-- +goose StatementBegin
CREATE FUNCTION bookstore.scope_in_use(t text,k text,s text) RETURNS boolean
LANGUAGE sql SECURITY DEFINER SET search_path=pg_catalog AS $$
 SELECT EXISTS(SELECT 1 FROM bookstore.books WHERE tenant_id=t AND scope_kind=k AND scope_id=s)
 OR EXISTS(SELECT 1 FROM pangolin_events.outbox WHERE tenant_id=t AND scope_kind=k AND scope_id=s AND state<>'sent')
 OR EXISTS(SELECT 1 FROM pangolin_events.inbox WHERE tenant_id=t AND scope_kind=k AND scope_id=s AND state='pending')
$$;
-- +goose StatementEnd
REVOKE ALL ON FUNCTION bookstore.scope_in_use(text,text,text) FROM PUBLIC;
GRANT USAGE ON SCHEMA bookstore TO pangolin_worker;
GRANT EXECUTE ON FUNCTION bookstore.scope_in_use(text,text,text) TO pangolin_worker;
