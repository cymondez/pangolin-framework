const profileName = "organization-enabled"

func profile(_ context.Context, manager uow.UnitOfWorkManager, pool *pgxpool.Pool, authority tenantpg.Authority, idem *idempotency.Store, effects infrastructure.Effects, tenants *tenancy.Resolver, validator *authn.Validator) (*scope.Registry, http.Handler, error) {
	store, err := organization.NewStore(organization.StoreOptions{AuthorityPool: pool, Manager: manager, Identity: tenancy.Identity, Tenants: authority, Idempotency: idem, Permissions: organization.PermissionFunc(func(_ context.Context, s organization.Snapshot, action string) error {
		if s.Principal.ID != "alice" {
			return scope.ErrDenied
		}
		if s.Role == "tenant" {
			switch action {
			case "tenant.enterprise.create", "tenant.organization.create", "tenant.scope.recover":
				return nil
			}
			return scope.ErrDenied
		}
		if action == "books.read" || action == "books.write" || s.Role == "owner" {
			return nil
		}
		return scope.ErrDenied
	}), Effects: organization.EffectsFunc(func(c context.Context, v organization.Change) error {
		operation, err := effects.Operation(c)
		if err != nil {
			return err
		}
		if err := (audit.Recorder{}).Record(c, audit.Record{Action: v.Action, Resource: v.Target.ID, Result: "success", Trace: operation}); err != nil {
			return err
		}
		return effects.Event(c, v.Action, v.Payload)
	}), UseChecker: organization.UseCheckerFunc(func(c context.Context, r scope.ScopeRef) (bool, error) {
		var used bool
		err := pool.QueryRow(c, "SELECT bookstore.scope_in_use($1,$2,$3)", r.TenantID, r.Kind, r.ID).Scan(&used)
		return used, err
	})})
	if err != nil {
		return nil, nil, err
	}
	provider, err := organization.NewProvider(store)
	if err != nil {
		return nil, nil, err
	}
	registry, err := scope.NewRegistry(tenancy.Identity, tenancy.Provider{Authority: authority, Permission: permission}, provider)
	if err != nil {
		return nil, nil, err
	}
	handler, err := orghttp.NewHandler(orghttp.Options{Management: store, Manager: manager, Timeout: 5 * time.Second, MaxBodyBytes: 1 << 20, AuthenticateCredential: validator.AuthenticateCredential, Credentials: transport.BearerCredentials(), ResolveTenant: func(c context.Context, r *http.Request) (context.Context, error) {
		return tenants.Resolve(c, "", r.Header.Get("X-Tenant-ID"))
	}, ResolveScope: func(c context.Context, r *http.Request) (context.Context, error) {
		_, tenant, _ := tenancy.Identity(c)
		kind, id := r.Header.Get("X-Scope-Kind"), r.Header.Get("X-Scope-ID")
		if kind == "" && id == "" {
			kind, id = "tenant", tenant
		}
		if kind == "" || id == "" {
			return nil, scope.ErrRequired
		}
		return registry.Bind(c, scope.ScopeRef{TenantID: tenant, Kind: kind, ID: id})
	}, Authorize: registry.Authorize})
	return registry, handler, err
}
func profileMigrations() (map[string]fs.FS, []migration.ModuleMigrations) {
	return map[string]fs.FS{"organization": organization.Migrations()}, []migration.ModuleMigrations{{Module: "organization", Directory: "organization", DependsOn: []string{"scope", "tenant"}}}
}
func profileSchemas() []distributed.Schema {
	result := []distributed.Schema{}
	for _, name := range []string{"enterprise.created", "organization.created", "organization.membership.changed", "organization.membership.removed", "enterprise.role.changed", "organization.transferred", "scope.suspended", "scope.active", "scope.archived", "organization.provider.imported"} {
		result = append(result, distributed.Schema{Type: name, Version: 1})
	}
	return result
}

