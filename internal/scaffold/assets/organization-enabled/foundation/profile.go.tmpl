// ProfileName identifies this assembly for the deployment compatibility
// check.
const ProfileName = "organization-enabled"

// ScopeKinds declares the scope kinds the startup composition must provide
// before any module accepts work.
func ScopeKinds() []string { return []string{"tenant", "org.enterprise", "org.organization"} }

// Migrations adds the organization migration source to the deployment
// ordering.
func Migrations() (map[string]fs.FS, []migration.ModuleMigrations) {
	return map[string]fs.FS{"organization": organization.Migrations()}, []migration.ModuleMigrations{{Module: "organization", Directory: "organization", DependsOn: []string{"scope", "tenant"}}}
}

