INSERT INTO pangolin.resource_scopes(tenant_id,scope_kind,scope_id) VALUES
 ('tenant-a','org.enterprise','00000000-0000-4000-8000-000000000001'),
 ('tenant-a','org.organization','00000000-0000-4000-8000-000000000002'),
 ('tenant-a','org.organization','00000000-0000-4000-8000-000000000003') ON CONFLICT DO NOTHING;
INSERT INTO pangolin_organization.enterprises(tenant_id,id,slug) VALUES('tenant-a','00000000-0000-4000-8000-000000000001','demo-enterprise') ON CONFLICT DO NOTHING;
INSERT INTO pangolin_organization.organizations(tenant_id,id,enterprise_id,slug) VALUES
 ('tenant-a','00000000-0000-4000-8000-000000000002','00000000-0000-4000-8000-000000000001','demo-org-a'),
 ('tenant-a','00000000-0000-4000-8000-000000000003',NULL,'demo-org-b') ON CONFLICT DO NOTHING;
INSERT INTO pangolin_organization.organization_memberships(tenant_id,organization_id,principal_kind,principal_id,role) VALUES
 ('tenant-a','00000000-0000-4000-8000-000000000002','user','alice','owner'),
 ('tenant-a','00000000-0000-4000-8000-000000000003','user','alice','owner') ON CONFLICT DO NOTHING;
INSERT INTO pangolin_organization.enterprise_roles(tenant_id,enterprise_id,principal_kind,principal_id,role) VALUES('tenant-a','00000000-0000-4000-8000-000000000001','user','alice','owner') ON CONFLICT DO NOTHING;
INSERT INTO pangolin_organization.owners(tenant_id,scope_kind,scope_id,principal_kind,principal_id) SELECT tenant_id,scope_kind,scope_id,'user','alice' FROM pangolin.resource_scopes WHERE scope_kind LIKE 'org.%' ON CONFLICT DO NOTHING;
`)
