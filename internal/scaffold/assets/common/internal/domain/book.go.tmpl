package domain

import (
	"errors"
	"strings"
)

type Book struct {
	ID    string `json:"id"`
	Title string `json:"title"`
}

var ErrInvalid = errors.New("VALIDATION_FAILED")

func (b Book) Validate() error {
	if strings.TrimSpace(b.ID) == "" || len(b.ID) > 128 || strings.TrimSpace(b.Title) == "" || len(b.Title) > 300 {
		return ErrInvalid
	}
	return nil
}
