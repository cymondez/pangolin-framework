package domain

import (
	"errors"
	"strings"
	"unicode/utf8"
)

type Book struct {
	ID    string `json:"id"`
	Title string `json:"title"`
}

var ErrInvalid = errors.New("VALIDATION_FAILED")

func (b Book) Validate() error {
	if strings.TrimSpace(b.ID) == "" || utf8.RuneCountInString(b.ID) > 128 || strings.TrimSpace(b.Title) == "" || utf8.RuneCountInString(b.Title) > 300 || strings.ContainsRune(b.ID, 0) || strings.ContainsRune(b.Title, 0) {
		return ErrInvalid
	}
	return nil
}
