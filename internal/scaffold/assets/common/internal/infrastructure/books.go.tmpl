type Failure struct {
	status int
	code   string
	cause  error
}

func (e Failure) Error() string   { return e.code }
func (e Failure) Unwrap() error   { return e.cause }
func (e Failure) HTTPStatus() int { return e.status }
func (e Failure) Code() string    { return e.code }

type Repository struct{}

func (Repository) Insert(ctx context.Context, b domain.Book) error {
	e, err := postgres.Current(ctx, true)
	if err != nil {
		return err
	}
	owner, _ := scope.Current(ctx)
	_, err = e.Exec(ctx, insertSQL, owner.Ref.TenantID, owner.Ref.Kind, owner.Ref.ID, b.ID, b.Title)
	var p *pgconn.PgError
	if errors.As(err, &p) && p.Code == "23505" {
		return Failure{409, "CONFLICT", err}
	}
	return err
}
func (Repository) Get(ctx context.Context, id string) (domain.Book, error) {
	e, err := postgres.Current(ctx, false)
	if err != nil {
		return domain.Book{}, err
	}
	owner, _ := scope.Current(ctx)
	var b domain.Book
	err = e.QueryRow(ctx, getSQL, owner.Ref.TenantID, owner.Ref.Kind, owner.Ref.ID, id).Scan(&b.ID, &b.Title)
	if errors.Is(err, pgx.ErrNoRows) {
		err = Failure{404, "NOT_FOUND", err}
	}
	return b, err
}

type Effects struct {
	Publisher *outbox.Publisher
	Manager   uow.UnitOfWorkManager
}

func (e Effects) Operation(ctx context.Context) (string, error) {
	if e.Manager == nil {
		return "", uow.ErrRequired
	}
	s, ok := e.Manager.Current(ctx)
	if !ok {
		return "", uow.ErrRequired
	}
	return s.ID(), nil
}

func (e Effects) Event(ctx context.Context, eventType string, payload json.RawMessage) error {
	b, _ := scope.Current(ctx)
	id := rand.Text()
	operation, err := e.Operation(ctx)
	if err != nil {
		return err
	}
	event := distributed.Envelope{ID: id, Type: eventType, SchemaVersion: 1, OccurredAt: time.Now().UTC(), TenantID: b.Ref.TenantID, ScopeKind: b.Ref.Kind, ScopeID: b.Ref.ID, CorrelationID: operation, CausationID: operation, Producer: "bookstore", Payload: payload}
	return e.Publisher.Publish(ctx, event)
}
func (e Effects) Created(ctx context.Context, b domain.Book) error {
	operation, err := e.Operation(ctx)
	if err != nil {
		return err
	}
	if err := (audit.Recorder{}).Record(ctx, audit.Record{Action: "books.created", Resource: fmt.Sprintf("book:%x", sha256.Sum256([]byte(b.ID))), Result: "success", Trace: operation}); err != nil {
		return err
	}
	payload, _ := json.Marshal(b)
	return e.Event(ctx, "bookstore.book.created", payload)
}
