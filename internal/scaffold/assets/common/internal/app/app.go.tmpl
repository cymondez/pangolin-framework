// bookToken is the composition identity of the bookstore service this app
// owns; every framework resource it consumes comes from the foundation module
// contracts through typed resolution, never from low-level composition here.
var bookToken = di.NewKey[application.Books]("app.books")

type requestError struct {
	cause  error
	status int
	code   string
}

func (e requestError) Error() string   { return e.code }
func (e requestError) Unwrap() error   { return e.cause }
func (e requestError) HTTPStatus() int { return e.status }
func (e requestError) Code() string    { return e.code }

// rootApplication is the HTTP/drain assembly of this generated app. The
// module owns no platform resource: pools, unit-of-work manager, scope
// registry and event resources are owned by the foundation module, and the
// profile module realizes profile-specific implementations under foundation
// contracts. Ordinary user modules (generated modules.UserRoot) depend on the
// foundation Type and inject framework services by type; only this root —
// which the aggregate already pulls in — touches HTTP and drain wiring, so
// business packages never import the app root.
type rootApplication struct {
	realtime realtimeState
	bridge   *drainParticipant
	serveErr chan error
	listen   string
}

func (ra *rootApplication) ModuleMetadata() module.Metadata {
	return module.Metadata{Name: "app", Version: "0.1.0", RequiredScopeKinds: foundation.ScopeKinds()}
}

// DependsOn composes the root closure: foundation resources and contracts
// first, the profile contribution second, then the typed user module
// aggregate. The loader plans shared dependency Types exactly once.
func (ra *rootApplication) DependsOn() []module.Ref {
	return append([]module.Ref{module.Of[foundation.Module](), module.Of[foundation.Profile](), module.Of[modules.UserRoot]()}, ra.realtime.refs()...)
}

func (ra *rootApplication) Configure(b module.RootBuilder) error {
	return b.Provide(di.Provider{Key: bookToken, Lifetime: di.Singleton, DependsOn: []di.Token{foundation.Scopes, foundation.Effects, foundation.Idempotency}, Factory: ra.newBooks})
}

func (ra *rootApplication) newBooks(ctx context.Context, resolve di.Resolver) (any, di.Cleanup, error) {
	scopesValue, err := resolve.Resolve(ctx, foundation.Scopes)
	if err != nil {
		return nil, nil, err
	}
	authorizer, ok := scopesValue.(policy.Authorizer)
	if !ok {
		return nil, nil, errors.New("scope contract is not a policy authorizer")
	}
	effectsValue, err := resolve.Resolve(ctx, foundation.Effects)
	if err != nil {
		return nil, nil, err
	}
	effects, ok := effectsValue.(infrastructure.Effects)
	if !ok {
		return nil, nil, errors.New("effects contract is not the framework bundle")
	}
	idemValue, err := resolve.Resolve(ctx, foundation.Idempotency)
	if err != nil {
		return nil, nil, err
	}
	idem, ok := idemValue.(*idempotency.Store)
	if !ok {
		return nil, nil, errors.New("idempotency contract is not the framework store")
	}
	return application.Books{Repository: infrastructure.Repository{}, Authorizer: authorizer, Idempotency: idem, Effects: effects}, nil, nil
}

// drainParticipant bridges the HTTP server accepted in module Start into the
// host drain contract: admission stops first, drain waits under its deadline.
type drainParticipant struct {
	work   *runtime.WorkGroup
	mu     sync.Mutex
	server *http.Server
	extra  runtime.Participant
}

func (p *drainParticipant) attach(server *http.Server) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.server = server
}

func (p *drainParticipant) Quiesce(ctx context.Context) error {
	p.mu.Lock()
	server := p.server
	p.mu.Unlock()
	if server != nil {
		server.SetKeepAlivesEnabled(false)
	}
	err := p.work.Quiesce(ctx)
	if p.extra != nil {
		err = errors.Join(err, p.extra.Quiesce(ctx))
	}
	return err
}
func (p *drainParticipant) Drain(ctx context.Context) error {
	p.mu.Lock()
	server := p.server
	p.mu.Unlock()
	var err error
	if p.extra != nil {
		err = p.extra.Drain(ctx)
	}
	if server != nil {
		if err := server.Shutdown(ctx); err != nil {
			return errors.Join(err, p.work.Drain(ctx))
		}
	}
	return errors.Join(err, p.work.Drain(ctx))
}
func (p *drainParticipant) Cancel() {
	p.work.Cancel()
	if p.extra != nil {
		p.extra.Cancel()
	}
}

func (ra *rootApplication) Start(ctx context.Context, rt module.Runtime) error {
	// The deployment compatibility check resolves every platform service
	// first: an incompatible profile or schema refuses Ready and the failure
	// path reclaims every acquired resource through the container.
	if err := ra.checkAndResolve(ctx, rt); err != nil {
		return err
	}
	managerValue, err := rt.Services().Resolve(ctx, foundation.UnitOfWork)
	if err != nil {
		return err
	}
	manager, ok := managerValue.(uow.UnitOfWorkManager)
	if !ok {
		return errors.New("unit-of-work contract is not the framework manager")
	}
	resolved := struct {
		tenants   *tenancy.Resolver
		validator *authn.Validator
		scopes    *scope.Registry
	}{}
	tenantsValue, err := rt.Services().Resolve(ctx, foundation.Tenants)
	if err != nil {
		return err
	}
	resolved.tenants, ok = tenantsValue.(*tenancy.Resolver)
	if !ok {
		return errors.New("tenant resolver is not the framework resolver")
	}
	validatorValue, err := rt.Services().Resolve(ctx, foundation.Validator)
	if err != nil {
		return err
	}
	resolved.validator, ok = validatorValue.(*authn.Validator)
	if !ok {
		return errors.New("credential validator is not the framework validator")
	}
	scopesValue, err := rt.Services().Resolve(ctx, foundation.Scopes)
	if err != nil {
		return err
	}
	resolved.scopes, ok = scopesValue.(*scope.Registry)
	if !ok {
		return errors.New("scope contract is not the framework registry")
	}
	booksValue, err := rt.Services().Resolve(ctx, bookToken)
	if err != nil {
		return err
	}
	books := booksValue.(application.Books)
	databaseValue, err := rt.Services().Resolve(ctx, foundation.ApplicationDatabase)
	if err != nil {
		return err
	}
	database, ok := databaseValue.(foundation.DB)
	if !ok {
		return errors.New("application database is not the foundation handle")
	}
	log, _ := audit.NewSecurityLog(os.Stderr, tenancy.Identity)
	scopes := resolved.scopes
	tenants := resolved.tenants
	validator := resolved.validator
	mux := http.NewServeMux()
	if err := ra.realtime.mount(ctx, rt, mux, ra.bridge); err != nil {
		return err
	}
	mux.HandleFunc("GET /livez", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) })
	mux.HandleFunc("GET /readyz", func(w http.ResponseWriter, r *http.Request) {
		c, cancel := context.WithTimeout(r.Context(), time.Second)
		defer cancel()
		if database.Pool.Ping(c) != nil {
			w.WriteHeader(503)
			return
		}
		w.WriteHeader(204)
	})
	resolveTenant := func(c context.Context, r *http.Request) (context.Context, error) {
		return tenants.Resolve(c, "", r.Header.Get("X-Tenant-ID"))
	}
	resolveScope := func(c context.Context, r *http.Request) (context.Context, error) {
		_, tenant, _ := tenancy.Identity(c)
		kind, id := r.Header.Get("X-Scope-Kind"), r.Header.Get("X-Scope-ID")
		if kind == "" && id == "" {
			kind, id = "tenant", tenant
		}
		if kind == "" || id == "" {
			return nil, scope.ErrRequired
		}
		return scopes.Bind(c, scope.ScopeRef{TenantID: tenant, Kind: kind, ID: id})
	}
	for _, route := range []struct {
		pattern, permission string
		read                bool
	}{{"POST /books", "books.write", false}, {"GET /books/{id}", "books.read", true}} {
		mux.HandleFunc(route.pattern, func(w http.ResponseWriter, r *http.Request) {
			key := r.Header.Get("Idempotency-Key")
			// Default HTTP profile uses the extension ports: Bearer credential
			// extraction plus the trusted credential authentication pipeline.
			pipeline, _ := transport.NewPipeline(transport.PipelineOptions{Timeout: 5 * time.Second, MaxBodyBytes: 1 << 20, Manager: manager, ReadOnly: route.read, AuthenticateCredential: validator.AuthenticateCredential, Credentials: transport.BearerCredentials(), ResolveTenant: resolveTenant, ResolveScope: resolveScope, Entry: func(c context.Context) error { return scopes.Authorize(c, route.permission) }, Rejected: func(c context.Context, _ error) {
				_ = log.Write(c, audit.Record{Action: "request.rejected", Resource: "bookstore", Result: "denied", Trace: rand.Text()})
			}, Decode: func(raw []byte) (any, error) {
				if route.read {
					if len(raw) != 0 {
						return nil, requestError{scope.ErrInvalid, 400, "MALFORMED_REQUEST"}
					}
					return nil, nil
				}
				var b domain.Book
				d := json.NewDecoder(bytes.NewReader(raw))
				d.DisallowUnknownFields()
				if err := d.Decode(&b); err != nil {
					return nil, requestError{err, 400, "MALFORMED_REQUEST"}
				}
				if !json.Valid(raw) || key == "" {
					return nil, requestError{scope.ErrInvalid, 400, "MALFORMED_REQUEST"}
				}
				if err := b.Validate(); err != nil {
					return nil, requestError{err, 422, "VALIDATION_FAILED"}
				}
				return b, nil
			}, Work: func(c context.Context, dto any) (any, error) {
				if route.read {
					return books.Get(c, r.PathValue("id"))
				}
				return books.Create(c, dto.(domain.Book), key)
			}})
			pipeline.ServeHTTP(w, r)
		})
	}
	optionalValue, optionalErr := rt.Services().Resolve(ctx, foundation.OptionalHandler)
	if optionalErr != nil {
		return optionalErr
	}
	// Unmounted is the foundation stand-in for "no profile handler"; any
	// other value is the profile control-plane surface.
	if _, unmounted := optionalValue.(foundation.Unmounted); !unmounted {
		if handler, ok := optionalValue.(http.Handler); ok && handler != nil {
			mux.Handle("/", handler)
		}
	}
	listen := ra.listen
	if listen == "" {
		listen = "127.0.0.1:18081"
	}
	server := &http.Server{Addr: listen, ReadHeaderTimeout: 3 * time.Second, ReadTimeout: 6 * time.Second, WriteTimeout: 6 * time.Second, IdleTimeout: 30 * time.Second}
	server.Handler = http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		c, done, err := ra.bridge.work.Enter(req.Context())
		if err != nil {
			transport.WriteError(w, req, err)
			return
		}
		defer done()
		mux.ServeHTTP(w, req.WithContext(c))
	})
	ra.bridge.attach(server)
	if ra.serveErr != nil {
		listener, listenErr := net.Listen("tcp", listen)
		if listenErr != nil {
			return listenErr
		}
		go func() { ra.serveErr <- server.Serve(listener) }()
	}
	return nil
}

// checkAndResolve runs the deployment migration/profile compatibility check
// before serving and resolves the platform composition through the module
// resolver, so every foundation factory has succeeded when the check reads
// the database.
func (ra *rootApplication) checkAndResolve(ctx context.Context, rt module.Runtime) error {
	for _, token := range []di.Token{foundation.UnitOfWork, foundation.Publisher, foundation.Idempotency, foundation.Effects, foundation.Scopes, foundation.Tenants, foundation.Validator, foundation.ApplicationRegistry(), foundation.OptionalHandler} {
		if _, err := rt.Services().Resolve(ctx, token); err != nil {
			return err
		}
	}
	check, err := openMigrationSQL(os.Getenv("PANGOLIN_DSN"))
	if err != nil {
		return err
	}
	defer check.Close()
	version, err := maxUserMigrationPrefix()
	if err != nil {
		return err
	}
	runner, err := migration.NewPostgres(check, migration.Filesystem("."), version, version)
	if err != nil {
		return err
	}
	if err = runner.CheckCompatibility(ctx); err != nil {
		return err
	}
	var installedProfile string
	if err = check.QueryRowContext(ctx, "SELECT name FROM bookstore.profile").Scan(&installedProfile); err != nil {
		return errors.Join(scope.ErrMigrationRequired, err)
	}
	if installedProfile != foundation.ProfileName {
		return scope.ErrMigrationRequired
	}
	return nil
}

func openMigrationSQL(dsn string) (*sql.DB, error) {
	if dsn == "" {
		return nil, errors.New("database DSN required in environment")
	}
	return sql.Open("pgx", dsn)
}

// maxUserMigrationPrefix is the highest user migration prefix for the
// compatibility check; deployment ordering keeps module migration files
// globally unique.
func maxUserMigrationPrefix() (int64, error) {
	var maximum int64 = 5000000
	err := filepath.WalkDir("modules", func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if d.IsDir() || filepath.Ext(path) != ".sql" {
			return nil
		}
		prefix, _, ok := strings.Cut(d.Name(), "_")
		n, parseErr := strconv.ParseInt(prefix, 10, 64)
		if !ok || parseErr != nil || n <= 0 {
			return errors.New("invalid module migration filename")
		}
		if n > maximum {
			maximum = n
		}
		return nil
	})
	return maximum, err
}

func (ra *rootApplication) Stop(context.Context, module.Runtime) error { return nil }

// Run hands the root module to StartRoot only; every pool, broker and
// profile resource is created later by the foundation factories, and the
// loader rejects invalid graphs before any of them runs.
func Run(ctx context.Context) error {
	serveErr := make(chan error, 1)
	root := &rootApplication{serveErr: serveErr, bridge: &drainParticipant{work: runtime.NewWorkGroup()}, listen: os.Getenv("PANGOLIN_LISTEN")}
	defaults := []config.Source{{Name: "defaults", Values: map[string]string{"uow.default_timeout": "5s", "uow.cleanup_timeout": "2s", "uow.hook_timeout": "1s", "uow.max_requires_new_depth": "4"}}}
	host, err := runtime.New(runtime.Options{DrainTimeout: 15 * time.Second, CleanupTimeout: 5 * time.Second}, defaults, root.bridge)
	if err != nil {
		return err
	}
	if err = runtime.StartRoot(ctx, host, append([]any{root}, root.realtime.roots()...)...); err != nil {
		return err
	}
	defer host.Stop(context.Background())
	select {
	case <-ctx.Done():
		return host.Stop(context.Background())
	case err = <-serveErr:
		if errors.Is(err, http.ErrServerClosed) {
			return nil
		}
		return err
	}
}
